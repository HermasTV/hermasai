# Environment Configuration for HermasAI (COMPLETELY OPTIONAL)
#
# 🎉 NO ENVIRONMENT VARIABLES REQUIRED!
#
# The application automatically detects:
# - Development: Uses DynamoDB Local (localhost:8000)
# - Production: Uses AWS DynamoDB (us-east-1 region)
# - All configuration managed via /admin control panel
#
# Default credentials: admin / hermasai2024
#
# This file is kept for reference only - you can delete it!

# For local development (optional override)
# NODE_ENV=development

# DEPRECATED: All these are now auto-detected or managed via admin panel
# DYNAMODB_LOCAL=true
# DYNAMODB_LOCAL_ENDPOINT=http://localhost:8000
# DYNAMODB_REGION=us-east-1
# NEXT_PUBLIC_PDF_CONVERTER_API_URL=http://YOUR-EC2-PUBLIC-IP:8000
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=hermasai2024