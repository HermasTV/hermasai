# Environment Configuration for HermasAI
# Simple 3-variable configuration - set these in AWS Amplify environment variables

# Python backend service URL (required)
PYTHON_SERVICES_URL=http://your-backend.com

# Admin panel credentials (required)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password

# For local development, use:
# PYTHON_SERVICES_URL=http://127.0.0.1:8000
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=hermasai2024