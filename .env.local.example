# Environment Configuration for HermasAI
# IMPORTANT: Use NEXT_PUBLIC_ prefix for frontend access

# Python backend service URL (required)
NEXT_PUBLIC_PYTHON_SERVICES_URL=http://your-backend.com

# Admin panel credentials (required)
NEXT_PUBLIC_ADMIN_USERNAME=admin
NEXT_PUBLIC_ADMIN_PASSWORD=your-secure-password

# Payload CMS Configuration (required for blog)
PAYLOAD_SECRET=your-payload-secret-key-here
MONGODB_URI=mongodb://localhost:27017/hermasai

# AWS S3 Configuration (required for media uploads)
S3_BUCKET=hermasai-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-aws-access-key-id
S3_SECRET_ACCESS_KEY=your-aws-secret-access-key

# For local development, use:
# NEXT_PUBLIC_PYTHON_SERVICES_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_ADMIN_USERNAME=admin
# NEXT_PUBLIC_ADMIN_PASSWORD=hermasai2024
# MONGODB_URI=mongodb://localhost:27017/hermasai