# Environment Configuration for HermasAI (Optional)
# All configuration is now managed through the admin control panel
# These variables are only used as fallbacks if DynamoDB is unavailable

# DynamoDB Configuration (for local development)
# Set to 'true' to use DynamoDB Local for development
DYNAMODB_LOCAL=true
DYNAMODB_LOCAL_ENDPOINT=http://localhost:8000

# DynamoDB Region (for production - cannot use AWS_ prefix in Amplify)
DYNAMODB_REGION=us-east-1

# Next.js Configuration
NODE_ENV=development

# DEPRECATED: These are now managed via admin panel
# NEXT_PUBLIC_PDF_CONVERTER_API_URL=http://YOUR-EC2-PUBLIC-IP:8000
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=hermasai2024