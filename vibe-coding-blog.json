      "blockType": "codeBlock",
      "language": "typescript",
      "code": "// Claude Code automatically configured complex webpack settings\n// for browser-based ML without me touching webpack.config.js\n\nconst nextConfig: NextConfig = {\n  webpack: (config) => {\n    config.resolve.alias = {\n      ...config.resolve.alias,\n      '@huggingface/transformers': path.resolve(\n        __dirname,\n        'node_modules/@huggingface/transformers'\n      ),\n    }\n    return config\n  },\n  // WebAssembly and WebGPU support configured automatically\n  experimental: {\n    outputFileTracingIncludes: {\n      '/projects/*': ['./public/**/*'],\n    },\n  },\n}",
      "filename": "next.config.ts",
      "showLineNumbers": true
